[Desktop Entry]
Type=Application
Name=Folio Deliver
GenericName=Presentation
Comment=Create and give presentations
Exec=folio-deliver %F
Icon=folio-deliver
Terminal=false
Categories=Office;Presentation;
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.slideshow;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.ms-powerpoint.presentation.macroEnabled.12;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;
Keywords=presentation;slides;pptx;powerpoint;slideshow;
StartupWMClass=org.folio.Deliver
Actions=Show;

[Desktop Action Show]
Name=Start Slide Show
Exec=folio-deliver --show %f
